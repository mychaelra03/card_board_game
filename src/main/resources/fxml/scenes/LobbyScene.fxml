            <cursor>
               <Cursor fx:constant="HAND" />
            </cursor>
            <graphic>
               <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
                  <image>
                     <Image url="@../../textures/icons/settingsIcon2.png" />
                  </image>
               </ImageView>
            </graphic>
         </Button>
         <Label fx:id="boardName" layoutX="606.0" layoutY="233.0" styleClass="whiteLabel" text="Default" AnchorPane.rightAnchor="250.0" AnchorPane.topAnchor="233.0">
