            </font></Label>
         <VBox fx:id="playerList" layoutX="41.0" layoutY="95.0" prefHeight="247.0" prefWidth="183.0" AnchorPane.bottomAnchor="378.0" AnchorPane.leftAnchor="41.0" AnchorPane.topAnchor="95.0">
            <padding>
               <Insets bottom="10.0" left="5.0" right="5.0" top="10.0" />
            </padding>
         </VBox>

         <ScrollPane fx:id="chatScrollPane" fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" layoutX="37.0" layoutY="417.0" prefHeight="220.0" prefWidth="490.0" style="-fx-border-color: gold; -fx-border-radius: 5; -fx-background-color: rgba(54, 0, 122, 1); -fx-background-insets: 0; -fx-background-radius: 0;" AnchorPane.bottomAnchor="83.0" AnchorPane.leftAnchor="37.0">
            <VBox fx:id="chatVbox" spacing="2" style="-fx-background-color: rgba(54, 0, 122, 1); -fx-background-insets: 0; -fx-background-radius: 0;">
               <padding>
                  <Insets bottom="10.0" left="15.0" right="15.0" top="10.0" />
               </padding>
            </VBox>
            <VBox.margin>
               <Insets />
            </VBox.margin>
         </ScrollPane>
      </AnchorPane>
   </children>
</StackPane>
