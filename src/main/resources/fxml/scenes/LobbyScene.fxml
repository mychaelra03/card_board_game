<StackPane fx:id="rootPane" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.polimi.galaxy_trucker.client.controllers.LobbyController">
   <children>
      <AnchorPane fx:id="mainContentPane" prefHeight="720.0" prefWidth="911.0" stylesheets="@../../css/lobby-scene.css">
         <stylesheets>
            <URL value="@../../css/default.css" />
            <URL value="@../../css/lobby-scene.css" />
         </stylesheets>
         <Region layoutX="264.0" layoutY="28.0" prefHeight="359.0" prefWidth="624.0" styleClass="region" AnchorPane.leftAnchor="264.0" AnchorPane.rightAnchor="28.0" AnchorPane.topAnchor="28.0" />
      
         <!-- Color selection -->
         <!--<VBox layoutX="620.0" layoutY="469.0" spacing="10" AnchorPane.leftAnchor="620.0" AnchorPane.topAnchor="469.0">
            <Label text="Color:" />
            <RadioButton fx:id="redButton" text="Red" />
            <RadioButton fx:id="blueButton" text="Blue" />
            <RadioButton fx:id="greenButton" text="Green" />
            <RadioButton fx:id="yellowButton" text="Yellow" />
         </VBox>-->
      
         <!-- Ready Button -->
         <Button fx:id="readyButton" layoutX="579.0" layoutY="622.0" prefHeight="79.0" prefWidth="316.0" text="%button.ready" AnchorPane.bottomAnchor="19.0" AnchorPane.leftAnchor="579.0" AnchorPane.rightAnchor="16.0" />
         <Button fx:id="prevMapButton" layoutX="273.0" layoutY="195.0" text="←" AnchorPane.leftAnchor="273.0" AnchorPane.topAnchor="195.0" />
         <ImageView fx:id="boardImage" fitHeight="300" fitWidth="500" layoutX="329.0" layoutY="58.0" />
         <Button fx:id="nextMapButton" layoutX="839.0" layoutY="195.0" text="→" AnchorPane.rightAnchor="38.0" AnchorPane.topAnchor="195.0" />
         <Region layoutX="23.0" layoutY="405.0" prefHeight="247.0" prefWidth="518.0" styleClass="region" />
         <TextField fx:id="chatTextField" layoutX="23.0" layoutY="662.0" onKeyPressed="#onEnterKeyPressed" prefHeight="28.0" prefWidth="469.0" promptText="Type a message..." AnchorPane.bottomAnchor="30.0" AnchorPane.leftAnchor="23.0" />
         <Region layoutX="23.0" layoutY="29.0" prefHeight="356.0" prefWidth="218.0" styleClass="region" AnchorPane.bottomAnchor="335.0" AnchorPane.leftAnchor="23.0" AnchorPane.topAnchor="29.0" />
         <Label layoutX="38.0" layoutY="50.0" styleClass="whiteLabel" text="Players logged:" AnchorPane.leftAnchor="38.0" AnchorPane.topAnchor="50.0">
            <font>
               <Font size="14.0" />
            </font>
         </Label>
         <Label fx:id="readyCounter" alignment="CENTER" prefHeight="40.0" prefWidth="100.0" text="0 / 4" textAlignment="CENTER" AnchorPane.bottomAnchor="110.0" AnchorPane.rightAnchor="30.0" />
         <Button fx:id="leftButton1" layoutX="497.0" layoutY="662.0" onAction="#onEnterKeyPressed" prefHeight="26.0" prefWidth="43.0" text="↑" AnchorPane.bottomAnchor="32.0" AnchorPane.leftAnchor="497.0" />
         <Label fx:id="playerCounter" alignment="CENTER_RIGHT" layoutX="176.0" layoutY="349.0" prefHeight="17.0" prefWidth="50.0" styleClass="whiteLabel" text="0 / 4" textFill="WHITE" AnchorPane.bottomAnchor="354.0" AnchorPane.leftAnchor="176.0" />
