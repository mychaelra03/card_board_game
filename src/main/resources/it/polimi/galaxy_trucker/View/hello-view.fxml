<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>

<!--<?import com.sun.org.apache.xpath.internal.operations.String?>-->

<AnchorPane fx:id="scene1AnchorPane" prefHeight="493.0" prefWidth="574.0" style="-fx-background-color: #0d1b2a; -fx-text-fill: white;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.polimi.galaxy_trucker.Client.Controller.Scene1.Scene1Controller">
    <!-- TextField per inserire il nome -->
    <TextField fx:id="usernameTextField" layoutX="20.0" layoutY="231.0" prefHeight="31.0" prefWidth="534.0" promptText="Insert your username" style="-fx-background-color: #560bad; -fx-text-fill: white; -fx-font-size: 16px; -fx-background-radius: 10;                   -fx-border-radius: 10;" AnchorPane.bottomAnchor="231.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" />
    <!-- ListView per i log -->
    <ListView fx:id="logList" layoutY="300.0" prefHeight="133.0" prefWidth="534.0" style="-fx-background-color: #560bad; -fx-text-fill: black;" AnchorPane.bottomAnchor="60.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" />

    <!-- Bottone per iniziare il gioco -->
    <Button fx:id="startButton" onAction="#onClickStart" prefHeight="31.0" prefWidth="460.0" style="-fx-background-color: #FFD700; -fx-text-fill: black; -fx-font-size: 18px; -fx-font-weight: bold;" text="Log to server" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" />
    <Label layoutX="20.0" layoutY="273.0" text="Choose an available server" textFill="WHITE" AnchorPane.bottomAnchor="203.0" AnchorPane.leftAnchor="20.0" />
   <ImageView fx:id="myImageView" fitHeight="212.0" layoutX="94.0" layoutY="14.0" pickOnBounds="true" preserveRatio="true" AnchorPane.topAnchor="14.0">
      <image>
         <Image url="@../../../../textures/title.png" />
      </image>
   </ImageView>


</AnchorPane>
