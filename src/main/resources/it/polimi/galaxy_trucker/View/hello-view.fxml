<?import javafx.scene.layout.AnchorPane?>

<!--<?import com.sun.org.apache.xpath.internal.operations.String?>-->

<AnchorPane fx:id="scene1AnchorPane" prefHeight="410.0" prefWidth="500.0" style="-fx-background-color: #0d1b2a; -fx-text-fill: white;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.polimi.galaxy_trucker.Client.Controller.Scene1.Scene1Controller">

    <!-- TextField per inserire il nome -->
    <TextField fx:id="usernameTextField" layoutX="20.0" layoutY="151.0" promptText="Insert your username" style="-fx-background-color: #560bad; -fx-text-fill: white; -fx-font-size: 16px;-fx-background-radius: 10;                   -fx-border-radius: 10;" AnchorPane.bottomAnchor="228.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" />

    <!-- Selettore avatar con una ComboBox -->

    <!-- ListView per i log -->
    <ListView fx:id="logList" layoutY="211.0" prefHeight="139.0" prefWidth="460.0" style="-fx-background-color: #560bad; -fx-text-fill: black;" AnchorPane.bottomAnchor="60.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" />

    <!-- Bottone per iniziare il gioco -->
    <Button fx:id="startButton" onAction="#onClickStart" prefHeight="31.0" prefWidth="460.0" style="-fx-background-color: #FFD700; -fx-text-fill: black; -fx-font-size: 18px; -fx-font-weight: bold;-fx-background-radius: 10; -fx-border-radius: 10;" text="Start to play" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" />
    <Label layoutX="20.0" layoutY="188.0" text="Choose a server to join:" textFill="WHITE" AnchorPane.bottomAnchor="205.0" AnchorPane.leftAnchor="20.0" />
   <ImageView fitHeight="157.0" fitWidth="250.0" layoutX="119.0" layoutY="6.0" pickOnBounds="true" preserveRatio="true" AnchorPane.leftAnchor="119.0" AnchorPane.rightAnchor="131.0" AnchorPane.topAnchor="6.0">
      <image>
         <Image url="@../../../../textures/title.png" />
      </image>
   </ImageView>


</AnchorPane>
