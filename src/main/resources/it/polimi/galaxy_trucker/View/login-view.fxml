<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.layout.AnchorPane?>
<AnchorPane prefHeight="600.0" prefWidth="500.0" style="-fx-background-color: #0d1b2a; -fx-text-fill: white;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.polimi.galaxy_trucker.TestLogin"
            fx:id="scene1AnchorPane" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/23.0.1">

    <ImageView fx:id="gameTitle" fitWidth="300" preserveRatio="true" />

    <HBox alignment="CENTER" spacing="20">
        <VBox alignment="CENTER" spacing="20" translateY="0">
            <Button fx:id="randomize" text="randomize" />
            <ImageView />
            <ImageView />
            <Button fx:id="leftBodyBtn" text="&lt;" />
            <Button fx:id="leftAccessoryBtn" text="&lt;" />
        </VBox>

        <StackPane>
            <ImageView fx:id="backgroundView" fitWidth="200" fitHeight="200" />
            <ImageView fx:id="bodyView" fitWidth="200" fitHeight="200" />
            <ImageView fx:id="accessoryView" fitWidth="200" fitHeight="200" />
        </StackPane>

        <VBox alignment="CENTER" spacing="40" translateY="0">
            <Button fx:id="random" text="options" />
            <Button fx:id="rightBodyBtn" text="&gt;" />
            <Button fx:id="rightAccessoryBtn" text="&gt;" />
        </VBox>
    </HBox>

    <HBox alignment="CENTER">
        <TextField fx:id="nameField" promptText="Enter your name" prefWidth="400"/>
    </HBox>

    <Label fx:id="errorLabel" textFill="red" visible="false" />

    <Button fx:id="playButton" text="Play" />

</AnchorPane>